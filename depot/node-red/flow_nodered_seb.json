  {
    "id": "seb0000000000105",
    "type": "function",
    "z": "seb0000000000001",
    "name": "Preparer affichage",
    "func": "// Prepare les donnees du Noeud Principal pour le dashboard\n// Sortie 1 : graphique BPM / Sortie 2 : graphique SpO2 / Sortie 3 : etat du capteur\nconst d = msg.payload;\n\nconst bpm  = d.bpm  > 0 ? { payload: d.bpm,  topic: \"BPM\" }  : null;\nconst spo2 = d.spo2 > 0 ? { payload: d.spo2, topic: \"SpO2\" } : null;\nconst etat = { payload: d.message };\n\nnode.status({\n    fill: d.code === 0 ? \"green\" : \"yellow\",\n    shape: \"dot\",\n    text: (d.bpm || \"--\") + \" bpm | SpO2 \" + (d.spo2 || \"--\") + \" %\"\n});\n\nreturn [bpm, spo2, etat];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "seb0000000000102"
      ],
      [
        "seb0000000000103"
      ],
      [
        "seb0000000000104"
      ]
    ],
    "outputLabels": [
      "BPM",
      "SpO2",
      "Etat"
    ],
    "x": 500,
    "y": 140
  },
