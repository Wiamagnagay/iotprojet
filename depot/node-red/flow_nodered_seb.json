  {
    "id": "seb0000000000112",
    "type": "function",
    "z": "seb0000000000001",
    "name": "LED verte (pouls normal)",
    "func": "// LED verte du Noeud de pilotage : allumee quand le pouls est normal\n// (meme seuils que la logique d'alarme, et pouls different de 0)\nconst BPM_MIN = 50;\nconst BPM_MAX = 100;\n\nconst bpm = msg.payload.bpm;\nconst normal = (bpm > 0 && bpm >= BPM_MIN && bpm <= BPM_MAX);\nconst etat = normal ? \"ON\" : \"OFF\";\n\n// On n'envoie un ordre que quand l'etat change\nif (etat === context.get(\"etat\")) {\n    return null;\n}\ncontext.set(\"etat\", etat);\n\nnode.status({ fill: normal ? \"green\" : \"grey\", shape: \"dot\", text: \"LED verte \" + etat });\nreturn { payload: etat };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "seb0000000000111"
      ]
    ],
    "x": 500,
    "y": 220
  },
