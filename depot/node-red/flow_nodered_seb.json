  {
    "id": "seb0000000000110",
    "type": "function",
    "z": "seb0000000000001",
    "name": "Logique alarme",
    "func": "// LOGIQUE D'ALARME\n// Entrees :\n//  - seb/patient/donnees : donnees du capteur (Noeud Principal)\n//  - seb/bouton          : etat du bouton (Noeud de pilotage)\n//\n// Etats :\n//  NORMAL    -> ALARME    : le pouls sort des seuils\n//  ALARME    -> ACQUITTEE : le bouton est appuye (le soignant a vu l'alarme)\n//  ALARME / ACQUITTEE -> NORMAL : le pouls revient dans les seuils\n// Apres un acquittement, l'alarme ne repart pas tant que le pouls\n// n'est pas redevenu normal puis anormal.\n\nconst BPM_MIN = 50;    // en dessous : frequence trop basse\nconst BPM_MAX = 100;   // au-dessus : frequence trop haute\n\nconst precedent = context.get(\"etat\") || \"NORMAL\";\nlet etat = precedent;\n\nif (msg.topic === \"seb/bouton\") {\n    // Le bouton n'agit que si une alarme est en cours\n    if (msg.payload === \"appuye\" && precedent === \"ALARME\") {\n        etat = \"ACQUITTEE\";\n    }\n}\nelse {\n    const bpm = msg.payload.bpm;\n    if (!(bpm > 0)) {\n        return null;   // pas de mesure valide (doigt retire...) : on ne change rien\n    }\n    const anormal = (bpm > BPM_MAX || bpm < BPM_MIN);\n    if (!anormal)                  etat = \"NORMAL\";\n    else if (precedent === \"NORMAL\") etat = \"ALARME\";\n}\n\nif (etat === precedent) {\n    return null;   // rien n'a change\n}\ncontext.set(\"etat\", etat);\n\nconst textes = {\n    NORMAL:    \"Pas d'alarme\",\n    ALARME:    \"ALARME : frequence cardiaque anormale !\",\n    ACQUITTEE: \"Alarme acquittee par le bouton\"\n};\n\nnode.status({\n    fill: etat === \"ALARME\" ? \"red\" : (etat === \"ACQUITTEE\" ? \"yellow\" : \"green\"),\n    shape: \"dot\",\n    text: etat\n});\n\n// Sortie 1 : ordre pour la LED du Noeud de pilotage\n// Sortie 2 : texte d'etat sur le dashboard\n// Sortie 3 : notification sur le dashboard (seulement quand l'alarme se declenche)\nconst versLED   = { payload: etat === \"ALARME\" ? \"ON\" : \"OFF\" };\nconst versTexte = { payload: textes[etat] };\nconst versNotif = (etat === \"ALARME\") ? { payload: textes.ALARME } : null;\n\nreturn [versLED, versTexte, versNotif];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "seb0000000000106",
        "seb0000000000107"
      ],
      [
        "seb0000000000108"
      ],
      [
        "seb0000000000109"
      ]
    ],
    "outputLabels": [
      "LED (ON/OFF)",
      "Texte alarme",
      "Notification"
    ],
    "x": 500,
    "y": 380
  },
